{
  "log": {
    "loglevel": "warning",
    "access": "/tmp/xray-access.log",
    "error": "/tmp/xray-error.log"
  },
  "inbounds": [
    {
      "tag": "trojan-ws",
      "listen": "127.0.0.1",
      "port": 10000,
      "protocol": "trojan",
      "settings": {"clients": []},
      "streamSettings": {"network": "ws", "security": "none", "wsSettings": {"path": "/ws/Ghanizada"}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"]}
    },
    {
      "tag": "vless-ws",
      "listen": "127.0.0.1",
      "port": 10001,
      "protocol": "vless",
      "settings": {"clients": [], "decryption": "none"},
      "streamSettings": {"network": "ws", "security": "none", "wsSettings": {"path": "/ws/VLESS-Ghanizada"}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"]}
    },
    {
      "tag": "vmess-ws",
      "listen": "127.0.0.1",
      "port": 10002,
      "protocol": "vmess",
      "settings": {"clients": []},
      "streamSettings": {"network": "ws", "security": "none", "wsSettings": {"path": "/ws/VMess-Ghanizada"}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"]}
    }
  ],
  "outbounds": [{"protocol": "freedom", "settings": {"domainStrategy": "UseIPv4"}}]
}
